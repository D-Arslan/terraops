# Copy to .env (git-ignored). Every value below is the docker-compose default;
# nothing here is a secret outside of a laptop.

# MLflow tracking + registry. The API only needs this (proxied artifacts).
MLFLOW_TRACKING_URI=http://localhost:5000

# Prediction log (src/prediction_log.py, src/drift_report.py, src/drift_monitor.py).
# Host port is 55433 on purpose: a native PostgreSQL often owns 5432 and the
# connection would silently reach the wrong database.
TERRAOPS_DB_URI=postgresql://mlflow:mlflow@localhost:55433/mlflow

# Streamlit UI -> API base URL (ui/streamlit_app.py). Inside compose: http://api:8000
API_URL=http://localhost:8000

# DVC remote (MinIO, bucket terraops-dvc). Put these in .dvc/config.local:
#   dvc remote modify --local minio access_key_id minioadmin
#   dvc remote modify --local minio secret_access_key minioadmin
# A fresh clone cannot `dvc pull`: the remote is a local MinIO, see README.

# Only for `python src/drift_monitor.py --dispatch` when the gh CLI is absent
# (REST fallback). Never needed for a dry run.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=D-Arslan/terraops
